generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Unified user roles - all in one enum
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SURVEYOR
  SALES
  DELIVERY
  COLLECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AgentStatus {
  AVAILABLE
  ON_FIELD
  OFF_DUTY
}

enum StoreStatus {
  PENDING
  SURVEYED
  SALES_VISITED
  DELIVERED
  COLLECTED
}

enum CustomerType {
  PROSPECT
  NEW
  EXISTING
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum PaymentStatus {
  FULL
  PARTIAL
  CREDIT
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

// Unified User model (combines old User and Agent tables)
model User {
  id     Int        @id @default(autoincrement())
  email  String     @unique
  name   String
  role   UserRole   @default(SALES)
  status UserStatus @default(ACTIVE)
  avatar String?

  // Web dashboard fields
  last_login DateTime @default(now())

  // Mobile/Field agent fields (nullable for web-only users)
  agent_status        AgentStatus? @map("agent_status")
  vehicle_id          Int?         @map("vehicle_id")
  current_lat         Float?       @map("current_lat")
  current_lng         Float?       @map("current_lng")
  last_seen           DateTime?    @map("last_seen")
  active_tasks_count  Int          @default(0) @map("active_tasks_count")

  // Timestamps
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  // Relations
  vehicle           Vehicle?         @relation(fields: [vehicle_id], references: [id])
  attendance_records Attendance[]
  timeline_events   TimelineEvent[]
  visit_logs        VisitLog[]
  store_assignments          Store[]
  fuel_entries               FuelEntry[]
  announcements              Announcement[]
  announcement_acknowledgments AnnouncementAcknowledgment[]
  surveyor_surveys           Survey[]                       @relation("SurveyorSurveys")
  assigned_surveys           Survey[]                       @relation("AssignedSurveys")
  gps_tracking_points GpsTrackingPoint[]
  created_transactions Transaction[]  @relation("TransactionCreator")
  reviewed_transactions Transaction[] @relation("TransactionReviewer")
  assigned_deliveries DeliveryOrder[] @relation("AssignedDeliveries")
  created_deliveries DeliveryOrder[]  @relation("CreatedDeliveries")

  @@index([email])
  @@index([role])
  @@index([vehicle_id])
  @@map("users")
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  model       String
  plate       String        @unique
  total_km    Float         @default(0) @map("total_km")
  fuel_rate   Float         @map("fuel_rate")
  status      VehicleStatus @default(AVAILABLE)
  assigned_to String?       @map("assigned_to")
  created_at  DateTime      @default(now()) @map("created_at")
  updated_at  DateTime      @updatedAt @map("updated_at")

  // Relations
  users           User[]
  fuel_entries    FuelEntry[]
  timeline_events TimelineEvent[]

  @@index([plate])
  @@index([assigned_to])
  @@map("vehicles")
}

model Store {
  id                 Int          @id @default(autoincrement())
  name               String
  address            String
  lat                Float
  lng                Float
  status             StoreStatus  @default(PENDING)
  customer_type      CustomerType @default(PROSPECT) @map("customer_type")
  order_value        Float?       @map("order_value")
  collection_amount  Float?       @map("collection_amount")
  last_updated       DateTime     @default(now()) @map("last_updated")
  created_by         Int?         @map("created_by")
  created_at         DateTime     @default(now()) @map("created_at")
  updated_at         DateTime     @updatedAt @map("updated_at")

  // Current Assignment
  current_user_id   Int?      @map("current_user_id")
  current_user_name String?   @map("current_user_name")
  current_role      UserRole? @map("current_role")
  assigned_at       DateTime? @map("assigned_at")

  // Relations
  current_user User?           @relation(fields: [current_user_id], references: [id])
  timeline     TimelineEvent[]
  visit_history VisitLog[]

  @@index([status])
  @@index([customer_type])
  @@index([current_user_id])
  @@map("stores")
}

model TimelineEvent {
  id                  Int           @id @default(autoincrement())
  store_id            Int           @map("store_id")
  user_id             Int           @map("user_id")
  user_name           String        @map("user_name")
  role                UserRole
  vehicle_id          Int           @map("vehicle_id")
  status              StoreStatus
  timestamp           DateTime      @default(now())
  note                String?
  photo_url           String?       @map("photo_url")
  payment_status      PaymentStatus? @map("payment_status")
  amount_collected    Float?        @map("amount_collected")
  total_order_amount  Float?        @map("total_order_amount")
  created_at          DateTime      @default(now()) @map("created_at")

  // Relations
  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])

  @@index([store_id])
  @@index([user_id])
  @@index([timestamp])
  @@map("timeline_events")
}

model VisitLog {
  id                 Int      @id @default(autoincrement())
  store_id           Int      @map("store_id")
  user_id            Int      @map("user_id")
  user_name          String   @map("user_name")
  timestamp          DateTime @default(now())
  outcome            String
  location_verified  Boolean  @default(false) @map("location_verified")
  notes              String?
  created_at         DateTime @default(now()) @map("created_at")

  // Relations
  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@index([store_id])
  @@index([user_id])
  @@index([timestamp])
  @@map("visit_logs")
}

model Attendance {
  id              Int       @id @default(autoincrement())
  user_id         Int       @map("user_id")
  work_date       String    @map("work_date")           // YYYY-MM-DD format
  clock_in_time   DateTime  @map("clock_in_time")
  clock_out_time  DateTime? @map("clock_out_time")
  clock_in_lat    Float?    @map("clock_in_lat")
  clock_in_long   Float?    @map("clock_in_long")
  clock_out_lat   Float?    @map("clock_out_lat")
  clock_out_long  Float?    @map("clock_out_long")
  selfie_url      String?   @map("selfie_url")
  duration        String?
  total_distance  Float?    @map("total_distance")      // Total km traveled during shift
  created_at      DateTime  @default(now()) @map("created_at")
  updated_at      DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  gps_points      GpsTrackingPoint[]

  @@index([user_id])
  @@index([work_date])
  @@map("attendance")
}

model FuelEntry {
  id         Int      @id @default(autoincrement())
  vehicle_id Int      @map("vehicle_id")
  liters     Float
  cost       Float
  date       DateTime @default(now())
  logged_by  String   @map("logged_by")
  user_id    Int      @map("user_id")
  created_at DateTime @default(now()) @map("created_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([vehicle_id])
  @@index([user_id])
  @@index([date])
  @@map("fuel_entries")
}

model Announcement {
  id                      Int                          @id @default(autoincrement())
  title                   String
  content                 String
  target                  String                       @default("All")
  priority                AnnouncementPriority         @default(MEDIUM)
  requires_acknowledgment Boolean                      @default(false) @map("requires_acknowledgment")
  timestamp               DateTime                     @default(now())
  expires_at              DateTime?                    @map("expires_at")
  created_by              Int                          @map("created_by")
  created_at              DateTime                     @default(now()) @map("created_at")
  updated_at              DateTime                     @updatedAt @map("updated_at")

  // Relations
  user            User                           @relation(fields: [created_by], references: [id])
  acknowledgments AnnouncementAcknowledgment[]

  @@index([created_by])
  @@index([timestamp])
  @@map("announcements")
}

model AnnouncementAcknowledgment {
  id              Int          @id @default(autoincrement())
  announcement_id Int          @map("announcement_id")
  user_id         Int          @map("user_id")
  acknowledged_at DateTime     @default(now()) @map("acknowledged_at")
  created_at      DateTime     @default(now()) @map("created_at")

  // Relations
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([announcement_id, user_id])
  @@index([announcement_id])
  @@index([user_id])
  @@map("announcement_acknowledgments")
}

model Product {
  id              Int       @id @default(autoincrement())
  product_code    String    @unique @map("product_code")
  product_name    String    @map("product_name")
  description     String?
  category        String?
  unit_of_measure String?   @default("PIECE") @map("unit_of_measure")
  price           Decimal   @db.Decimal(12, 2)
  cost            Decimal?  @db.Decimal(12, 2)
  is_active       Boolean   @default(true) @map("is_active")
  image_url       String?   @map("image_url")
  stock_quantity  Int       @default(0) @map("stock_quantity")
  created_at      DateTime  @default(now()) @map("created_at")
  updated_at      DateTime  @default(now()) @map("updated_at")

  @@index([category], map: "idx_products_category")
  @@index([is_active], map: "idx_products_active")
  @@map("products")
}

model Survey {
  id                  Int       @id @default(autoincrement())
  store_name          String    @map("store_name")
  owner_name          String?   @map("owner_name")
  contact_number      String    @map("contact_number")
  contact_person      String?   @map("contact_person")
  current_supplier    String?   @map("current_supplier")
  customer_status     String    @default("PROSPECT") @map("customer_status")
  first_purchase_date DateTime? @map("first_purchase_date")
  address             String
  address_line1       String    @map("address_line1")
  address_line2       String    @map("address_line2")
  address_line3       String?   @map("address_line3")
  city                String
  province            String
  landmark            String?
  remarks             String?
  gps_latitude        Float     @map("gps_latitude")
  gps_longitude       Float     @map("gps_longitude")
  store_photo_url     String?   @map("store_photo_url")
  is_platinum_client  Boolean   @default(false) @map("is_platinum_client")
  surveyor_id         Int       @map("surveyor_id")
  surveyor_name       String    @map("surveyor_name")
  captured_at         DateTime  @default(now()) @map("captured_at")
  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  // Assignment fields
  assigned_to_id      Int?      @map("assigned_to_id")
  assigned_to_name    String?   @map("assigned_to_name")
  assigned_at         DateTime? @map("assigned_at")

  // Relations
  surveyor    User          @relation("SurveyorSurveys", fields: [surveyor_id], references: [id])
  assigned_to User?         @relation("AssignedSurveys", fields: [assigned_to_id], references: [id])
  transactions Transaction[]

  @@index([surveyor_id])
  @@index([assigned_to_id])
  @@index([created_at])
  @@index([province])
  @@index([city])
  @@map("surveys")
}

model GpsTrackingPoint {
  id              Int       @id @default(autoincrement())
  user_id         Int       @map("user_id")
  attendance_id   Int?      @map("attendance_id")
  latitude        Float
  longitude       Float
  accuracy        Float?                                // GPS accuracy in meters
  timestamp       DateTime  @default(now())
  speed           Float?                                // Speed in m/s (if available)
  heading         Float?                                // Direction in degrees (0-360)
  synced_at       DateTime? @map("synced_at")          // When synced from mobile
  created_at      DateTime  @default(now()) @map("created_at")

  // Relations
  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attendance      Attendance? @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([attendance_id])
  @@index([timestamp])
  @@map("gps_tracking_points")
}

model Transaction {
  id                    Int       @id @default(autoincrement())
  transaction_number    String    @unique @map("transaction_number")
  survey_id             Int?      @map("survey_id")
  assignment_id         Int?      @map("assignment_id")
  store_name            String    @map("store_name")
  total_amount          Decimal   @map("total_amount")
  payment_terms         String    @map("payment_terms")
  status                String    @default("PENDING")
  requires_delivery     Boolean   @default(false) @map("requires_delivery")
  delivery_date         DateTime? @map("delivery_date")
  created_by            Int       @map("created_by")
  reviewed_by           Int?      @map("reviewed_by")
  admin_notes           String?   @map("admin_notes")
  created_at            DateTime  @default(now()) @map("created_at")
  updated_at            DateTime  @updatedAt @map("updated_at")

  // Relations
  creator         User               @relation("TransactionCreator", fields: [created_by], references: [id])
  reviewer        User?              @relation("TransactionReviewer", fields: [reviewed_by], references: [id])
  survey          Survey?            @relation(fields: [survey_id], references: [id])
  items           TransactionItem[]
  delivery_orders DeliveryOrder[]

  @@index([created_by])
  @@index([reviewed_by])
  @@index([survey_id])
  @@index([status])
  @@index([created_at])
  @@map("transactions")
}

model TransactionItem {
  id               Int         @id @default(autoincrement())
  transaction_id   Int         @map("transaction_id")
  product_id       Int?        @map("product_id")
  product_name     String      @map("product_name")
  product_code     String?     @map("product_code")
  quantity         Int
  unit_price       Decimal     @map("unit_price")
  subtotal         Decimal
  discount_percent Decimal?    @default(0) @map("discount_percent")
  discount_amount  Decimal?    @default(0) @map("discount_amount")
  total_amount     Decimal     @map("total_amount")
  unit_of_measure  String?     @map("unit_of_measure")
  notes            String?
  created_at       DateTime    @default(now()) @map("created_at")

  // Relations
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
  @@index([product_id], map: "idx_transaction_items_product")
  @@map("transaction_items")
}

model DeliveryOrder {
  id                       Int       @id @default(autoincrement())
  order_number             String    @unique @map("order_number")
  transaction_id           Int       @map("transaction_id")
  survey_id                Int?      @map("survey_id")
  status                   String    @default("PENDING")
  delivery_date            DateTime  @map("delivery_date") @db.Date
  total_items              Int?      @map("total_items")
  items_description        String    @map("items_description")
  store_name               String    @map("store_name")
  delivery_address         String?   @map("delivery_address")
  contact_person           String?   @map("contact_person")
  contact_number           String?   @map("contact_number")
  gps_latitude             Decimal?  @map("gps_latitude") @db.Decimal(10, 8)
  gps_longitude            Decimal?  @map("gps_longitude") @db.Decimal(11, 8)
  special_instructions     String?   @map("special_instructions")
  assigned_to              Int?      @map("assigned_to")
  assigned_at              DateTime? @map("assigned_at")
  created_by               Int       @map("created_by")
  delivery_notes           String?   @map("delivery_notes")
  failure_reason           String?   @map("failure_reason")

  // Time tracking
  started_at               DateTime? @map("started_at")
  time_out                 DateTime? @map("time_out")
  time_in                  DateTime? @map("time_in")
  completed_at             DateTime? @map("completed_at")
  actual_delivery_date     DateTime? @map("actual_delivery_date") @db.Date
  actual_delivery_time     DateTime? @map("actual_delivery_time") @db.Time

  // Location tracking for start/end
  start_latitude           Decimal?  @map("start_latitude") @db.Decimal(10, 8)
  start_longitude          Decimal?  @map("start_longitude") @db.Decimal(11, 8)

  // Odometer readings
  km_out                   Decimal?  @map("km_out") @db.Decimal(10, 2)
  km_out_photo_url         String?   @map("km_out_photo_url")
  km_in                    Decimal?  @map("km_in") @db.Decimal(10, 2)
  km_in_photo_url          String?   @map("km_in_photo_url")

  // Proof of delivery
  delivery_proof_photo_url String?   @map("delivery_proof_photo_url")
  recipient_name           String?   @map("recipient_name")
  recipient_signature_url  String?   @map("recipient_signature_url")

  // Retry tracking
  retry_count              Int       @default(0) @map("retry_count")
  delivery_time_slot       String?   @map("delivery_time_slot")

  created_at               DateTime  @default(now()) @map("created_at")
  updated_at               DateTime  @default(now()) @map("updated_at")

  // Relations
  assigned_user    User? @relation("AssignedDeliveries", fields: [assigned_to], references: [id])
  created_by_user  User  @relation("CreatedDeliveries", fields: [created_by], references: [id])
  transaction      Transaction @relation(fields: [transaction_id], references: [id])

  @@index([assigned_to])
  @@index([created_by])
  @@index([status])
  @@index([delivery_date])
  @@index([transaction_id])
  @@map("delivery_orders")
}
