generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Unified user roles - all in one enum
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SURVEYOR
  SALES
  DELIVERY
  COLLECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AgentStatus {
  AVAILABLE
  ON_FIELD
  OFF_DUTY
}

enum StoreStatus {
  PENDING
  SURVEYED
  SALES_VISITED
  DELIVERED
  COLLECTED
}

enum CustomerType {
  PROSPECT
  NEW
  EXISTING
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum PaymentStatus {
  FULL
  PARTIAL
  CREDIT
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum SalesActivityType {
  COLD_CALL
  COLD_EMAIL
  QUOTATION_PREP
  CLIENT_FOLLOWUP
  REVIVE_DORMANT
  SOCIAL_PROSPECTING
  EMAIL_INQUIRY_REPLY
  CALL_INQUIRY_REPLY
  WEEKLY_TODO_PREP
  VEHICLE_RESERVATION
  SAMPLE_REQUEST
  MARKETING_MATERIAL_REQUEST
  DESIGN_REQUEST
  INTERNAL_PO
  SALES_MEETING
  WALKIN_CLIENT
  CLIENT_ISSUE
  DELIVERY_FOLLOWUP
  SAMPLE_FOLLOWUP
  PRICING_REQUEST
  STORE_VISIT
  OTHER
}

// Unified User model (combines old User and Agent tables)
model User {
  id     Int        @id @default(autoincrement())
  email  String     @unique
  name   String
  role   UserRole   @default(SALES)
  status UserStatus @default(ACTIVE)
  avatar String?

  // Web dashboard fields
  last_login DateTime @default(now())

  // Mobile/Field agent fields (nullable for web-only users)
  agent_status        AgentStatus? @map("agent_status")
  vehicle_id          Int?         @map("vehicle_id")
  current_lat         Float?       @map("current_lat")
  current_lng         Float?       @map("current_lng")
  last_seen           DateTime?    @map("last_seen")
  active_tasks_count  Int          @default(0) @map("active_tasks_count")

  // Timestamps
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  // Relations
  vehicle           Vehicle?         @relation(fields: [vehicle_id], references: [id])
  attendance_records Attendance[]
  attendance_sessions AttendanceSession[] @relation("UserAttendanceSessions")
  attendance_summary AttendanceSummary[] @relation("UserAttendanceSummary")
  visit_logs        VisitLog[]
  store_assignments          Store[]
  announcements              Announcement[]
  surveyor_surveys           Survey[]                       @relation("SurveyorSurveys")
  assigned_surveys           Survey[]                       @relation("AssignedSurveys")
  gps_tracking_points GpsTrackingPoint[]
  created_transactions Transaction[]  @relation("TransactionCreator")
  reviewed_transactions Transaction[] @relation("TransactionReviewer")
  assigned_deliveries DeliveryOrder[] @relation("AssignedDeliveries")
  created_deliveries DeliveryOrder[]  @relation("CreatedDeliveries")
  sales_activities SalesActivity[]
  survey_agent_assignments SurveyAssignment[] @relation("AssignedSurveyAgents")
  survey_assignments_made SurveyAssignment[] @relation("SurveyAssigner")
  orders_created Order[] @relation("OrderSalesAgent")
  orders_approved Order[] @relation("OrderApprover")
  orders_delivery_assigned Order[] @relation("OrderDeliveryUser")
  orders_collector_assigned Order[] @relation("OrderCollectorUser")
  collections Collection[] @relation("CollectionCollector")

  @@index([email])
  @@index([role])
  @@index([vehicle_id])
  @@map("users")
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  model       String
  plate       String        @unique
  total_km    Float         @default(0) @map("total_km")
  fuel_rate   Float         @map("fuel_rate")
  status      VehicleStatus @default(AVAILABLE)
  assigned_to String?       @map("assigned_to")
  created_at  DateTime      @default(now()) @map("created_at")
  updated_at  DateTime      @updatedAt @map("updated_at")

  // Relations
  users           User[]

  @@index([plate])
  @@index([assigned_to])
  @@map("vehicles")
}

model Store {
  id                 Int          @id @default(autoincrement())
  name               String
  address            String
  lat                Float
  lng                Float
  status             StoreStatus  @default(PENDING)
  customer_type      CustomerType @default(PROSPECT) @map("customer_type")
  order_value        Float?       @map("order_value")
  collection_amount  Float?       @map("collection_amount")
  last_updated       DateTime     @default(now()) @map("last_updated")
  created_by         Int?         @map("created_by")
  created_at         DateTime     @default(now()) @map("created_at")
  updated_at         DateTime     @updatedAt @map("updated_at")

  // Current Assignment
  current_user_id   Int?      @map("current_user_id")
  current_user_name String?   @map("current_user_name")
  current_role      UserRole? @map("current_role")
  assigned_at       DateTime? @map("assigned_at")

  // Relations
  current_user User?           @relation(fields: [current_user_id], references: [id])
  visit_history VisitLog[]

  @@index([status])
  @@index([customer_type])
  @@index([current_user_id])
  @@map("stores")
}

model VisitLog {
  id                 Int      @id @default(autoincrement())
  store_id           Int      @map("store_id")
  user_id            Int      @map("user_id")
  user_name          String   @map("user_name")
  user_role          UserRole @map("user_role")
  timestamp          DateTime @default(now())
  outcome            String
  location_verified  Boolean  @default(false) @map("location_verified")
  visit_lat          Float?   @map("visit_lat")
  visit_lng          Float?   @map("visit_lng")
  distance_from_store Float?  @map("distance_from_store") // Distance in meters from store location
  photo_url          String?  @map("photo_url")
  notes              String?
  created_at         DateTime @default(now()) @map("created_at")

  // Relations
  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@index([store_id])
  @@index([user_id])
  @@index([user_role])
  @@index([timestamp])
  @@map("visit_logs")
}

model Attendance {
  id               Int       @id @default(autoincrement())
  user_id          Int       @map("user_id")
  work_date        String    @map("work_date")           // YYYY-MM-DD format
  clock_in_time    DateTime  @map("clock_in_time")
  clock_out_time   DateTime? @map("clock_out_time")
  clock_in_lat     Float?    @map("clock_in_lat")
  clock_in_long    Float?    @map("clock_in_long")
  clock_out_lat    Float?    @map("clock_out_lat")
  clock_out_long   Float?    @map("clock_out_long")
  selfie_url       String?   @map("selfie_url")
  duration         String?
  total_distance   Float?    @map("total_distance")      // Total km traveled during shift
  auto_clocked_out Boolean   @default(false) @map("auto_clocked_out") // True if automatically clocked out at 5:30 PM
  created_at       DateTime  @default(now()) @map("created_at")
  updated_at       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  gps_points      GpsTrackingPoint[]

  @@index([user_id])
  @@index([work_date])
  @@index([auto_clocked_out])
  @@map("attendance")
}

// New model for multiple clock-in/out sessions per day
model AttendanceSession {
  id               Int       @id @default(autoincrement())
  user_id          Int       @map("user_id")
  work_date        String    @map("work_date")           // YYYY-MM-DD format
  clock_in_time    DateTime  @map("clock_in_time")
  clock_out_time   DateTime? @map("clock_out_time")
  clock_in_lat     Float?    @map("clock_in_lat")
  clock_in_long    Float?    @map("clock_in_long")
  clock_out_lat    Float?    @map("clock_out_lat")
  clock_out_long   Float?    @map("clock_out_long")
  duration_minutes Int?      @map("duration_minutes")    // Duration in minutes for this session
  total_distance   Float?    @map("total_distance")      // Total distance in kilometers
  auto_clocked_out Boolean   @default(false) @map("auto_clocked_out")
  created_at       DateTime  @default(now()) @map("created_at")
  updated_at       DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  user            User                @relation("UserAttendanceSessions", fields: [user_id], references: [id], onDelete: Cascade)
  gps_points      GpsTrackingSessionPoint[]

  @@index([user_id])
  @@index([work_date])
  @@index([work_date, user_id])
  @@index([clock_out_time])
  @@map("attendance_sessions")
}

// Summary table for daily attendance totals
model AttendanceSummary {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @map("user_id")
  work_date           String   @map("work_date")           // YYYY-MM-DD format
  total_hours         Decimal  @default(0) @map("total_hours") @db.Decimal(5, 2)  // Total hours worked (e.g., 8.50 for 8.5 hours)
  total_distance      Float?   @map("total_distance")      // Total distance in kilometers
  total_sessions      Int      @default(0) @map("total_sessions") // Number of clock-in/out sessions
  first_clock_in      DateTime @map("first_clock_in")
  last_clock_out      DateTime? @map("last_clock_out")
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user               User     @relation("UserAttendanceSummary", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, work_date])
  @@index([user_id])
  @@index([work_date])
  @@map("attendance_summary")
}

// GPS tracking points linked to sessions
model GpsTrackingSessionPoint {
  id              Int       @id @default(autoincrement())
  user_id         Int       @map("user_id")
  session_id      Int?      @map("session_id")  // Links to AttendanceSession
  latitude        Float
  longitude       Float
  accuracy        Float?
  timestamp       DateTime  @default(now())
  speed           Float?
  heading         Float?
  synced_at       DateTime? @map("synced_at")
  created_at      DateTime  @default(now()) @map("created_at")

  // Relations
  session         AttendanceSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_id])
  @@index([timestamp])
  @@map("gps_tracking_session_points")
}

model Announcement {
  id                      Int                          @id @default(autoincrement())
  title                   String
  content                 String
  target                  String                       @default("All")
  priority                AnnouncementPriority         @default(MEDIUM)
  requires_acknowledgment Boolean                      @default(false) @map("requires_acknowledgment")
  timestamp               DateTime                     @default(now())
  expires_at              DateTime?                    @map("expires_at")
  created_by              Int                          @map("created_by")
  created_at              DateTime                     @default(now()) @map("created_at")
  updated_at              DateTime                     @updatedAt @map("updated_at")

  // Relations
  user            User                           @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@index([timestamp])
  @@map("announcements")
}

model Survey {
  id                  Int       @id @default(autoincrement())
  store_name          String    @map("store_name")
  owner_name          String?   @map("owner_name")
  contact_number      String    @map("contact_number")
  contact_person      String?   @map("contact_person")
  current_supplier    String?   @map("current_supplier")
  customer_status     String    @default("PROSPECT") @map("customer_status")
  first_purchase_date DateTime? @map("first_purchase_date")
  address             String
  address_line1       String    @map("address_line1")
  address_line2       String    @map("address_line2")
  address_line3       String?   @map("address_line3")
  city                String
  province            String
  landmark            String?
  remarks             String?
  gps_latitude        Float     @map("gps_latitude")
  gps_longitude       Float     @map("gps_longitude")
  store_photo_url     String?   @map("store_photo_url")
  is_platinum_client  Boolean   @default(false) @map("is_platinum_client")
  surveyor_id         Int       @map("surveyor_id")
  surveyor_name       String    @map("surveyor_name")
  captured_at         DateTime  @default(now()) @map("captured_at")
  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  // Assignment fields
  assigned_to_id      Int?      @map("assigned_to_id")
  assigned_to_name    String?   @map("assigned_to_name")
  assigned_at         DateTime? @map("assigned_at")

  // Relations
  surveyor    User               @relation("SurveyorSurveys", fields: [surveyor_id], references: [id])
  assigned_to User?              @relation("AssignedSurveys", fields: [assigned_to_id], references: [id])
  transactions Transaction[]
  survey_assignments SurveyAssignment[]
  orders Order[]
  delivery_orders DeliveryOrder[] @relation("DeliveryOrderSurveys")

  @@index([surveyor_id])
  @@index([assigned_to_id])
  @@index([created_at])
  @@index([province])
  @@index([city])
  @@map("surveys")
}

model SurveyAssignment {
  id              Int      @id @default(autoincrement())
  survey_id       Int      @map("survey_id")
  sales_agent_id  Int      @map("sales_agent_id")
  assigned_by     Int?     @map("assigned_by")
  assigned_at     DateTime @default(now()) @map("assigned_at")
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  // Relations
  survey      Survey @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  sales_agent User   @relation("AssignedSurveyAgents", fields: [sales_agent_id], references: [id], onDelete: Cascade)
  assigner    User?  @relation("SurveyAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)

  @@unique([survey_id, sales_agent_id])
  @@index([survey_id])
  @@index([sales_agent_id])
  @@index([status])
  @@map("survey_assignments")
}

model GpsTrackingPoint {
  id              Int       @id @default(autoincrement())
  user_id         Int       @map("user_id")
  attendance_id   Int?      @map("attendance_id")
  latitude        Float
  longitude       Float
  accuracy        Float?                                // GPS accuracy in meters
  timestamp       DateTime  @default(now())
  speed           Float?                                // Speed in m/s (if available)
  heading         Float?                                // Direction in degrees (0-360)
  synced_at       DateTime? @map("synced_at")          // When synced from mobile
  created_at      DateTime  @default(now()) @map("created_at")

  // Relations
  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attendance      Attendance? @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([attendance_id])
  @@index([timestamp])
  @@map("gps_tracking_points")
}

model Transaction {
  id                    Int       @id @default(autoincrement())
  transaction_number    String    @unique @map("transaction_number")
  survey_id             Int?      @map("survey_id")
  assignment_id         Int?      @map("assignment_id")
  store_name            String    @map("store_name")
  total_amount          Decimal   @map("total_amount")
  payment_terms         String    @map("payment_terms")
  status                String    @default("PENDING")
  requires_delivery     Boolean   @default(false) @map("requires_delivery")
  delivery_date         DateTime? @map("delivery_date")
  created_by            Int       @map("created_by")
  reviewed_by           Int?      @map("reviewed_by")
  admin_notes           String?   @map("admin_notes")
  created_at            DateTime  @default(now()) @map("created_at")
  updated_at            DateTime  @updatedAt @map("updated_at")

  // Relations
  creator         User               @relation("TransactionCreator", fields: [created_by], references: [id])
  reviewer        User?              @relation("TransactionReviewer", fields: [reviewed_by], references: [id])
  survey          Survey?            @relation(fields: [survey_id], references: [id])
  delivery_orders DeliveryOrder[]

  @@index([created_by])
  @@index([reviewed_by])
  @@index([survey_id])
  @@index([status])
  @@index([created_at])
  @@map("transactions")
}

model DeliveryOrder {
  id                       Int       @id @default(autoincrement())
  order_number             String    @unique @map("order_number")
  transaction_id           Int       @map("transaction_id")
  survey_id                Int?      @map("survey_id")
  status                   String    @default("PENDING")
  delivery_date            DateTime  @map("delivery_date") @db.Date
  total_items              Int?      @map("total_items")
  items_description        String    @map("items_description")
  store_name               String    @map("store_name")
  delivery_address         String?   @map("delivery_address")
  contact_person           String?   @map("contact_person")
  contact_number           String?   @map("contact_number")
  gps_latitude             Decimal?  @map("gps_latitude") @db.Decimal(10, 8)
  gps_longitude            Decimal?  @map("gps_longitude") @db.Decimal(11, 8)
  special_instructions     String?   @map("special_instructions")
  assigned_to              Int?      @map("assigned_to")
  assigned_at              DateTime? @map("assigned_at")
  created_by               Int       @map("created_by")
  delivery_notes           String?   @map("delivery_notes")
  failure_reason           String?   @map("failure_reason")

  // Time tracking
  started_at               DateTime? @map("started_at")
  time_out                 DateTime? @map("time_out")
  time_in                  DateTime? @map("time_in")
  completed_at             DateTime? @map("completed_at")
  actual_delivery_date     DateTime? @map("actual_delivery_date") @db.Date
  actual_delivery_time     DateTime? @map("actual_delivery_time") @db.Time

  // Location tracking for start/end
  start_latitude           Decimal?  @map("start_latitude") @db.Decimal(10, 8)
  start_longitude          Decimal?  @map("start_longitude") @db.Decimal(11, 8)

  // Odometer readings
  km_out                   Decimal?  @map("km_out") @db.Decimal(10, 2)
  km_out_photo_url         String?   @map("km_out_photo_url")
  km_in                    Decimal?  @map("km_in") @db.Decimal(10, 2)
  km_in_photo_url          String?   @map("km_in_photo_url")

  // Proof of delivery
  delivery_proof_photo_url String?   @map("delivery_proof_photo_url")
  recipient_name           String?   @map("recipient_name")
  recipient_signature_url  String?   @map("recipient_signature_url")

  // Retry tracking
  retry_count              Int       @default(0) @map("retry_count")
  delivery_time_slot       String?   @map("delivery_time_slot")

  created_at               DateTime  @default(now()) @map("created_at")
  updated_at               DateTime  @default(now()) @map("updated_at")

  // Relations
  assigned_user    User? @relation("AssignedDeliveries", fields: [assigned_to], references: [id])
  created_by_user  User  @relation("CreatedDeliveries", fields: [created_by], references: [id])
  transaction      Transaction @relation(fields: [transaction_id], references: [id])
  survey           Survey? @relation("DeliveryOrderSurveys", fields: [survey_id], references: [id])

  @@index([assigned_to])
  @@index([created_by])
  @@index([status])
  @@index([delivery_date])
  @@index([transaction_id])
  @@index([survey_id])
  @@map("delivery_orders")
}

// App version control for mobile force updates
model AppConfig {
  id              String   @id @default(uuid()) @db.Uuid
  platform        String   // 'android' or 'ios'
  minimum_version String   @map("minimum_version")
  latest_version  String   @map("latest_version")
  force_update    Boolean  @default(false) @map("force_update")
  update_message  String?  @map("update_message")
  store_url       String?  @map("store_url")
  is_active       Boolean  @default(true) @map("is_active")
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@unique([platform])
  @@index([platform])
  @@index([is_active])
  @@map("app_config")
}

// Version change history for tracking
model AppVersionHistory {
  id              String   @id @default(uuid()) @db.Uuid
  platform        String
  version_number  String   @map("version_number")
  change_type     String   @map("change_type") // 'minimum_updated', 'latest_updated', 'force_enabled', 'force_disabled'
  previous_value  String?  @map("previous_value")
  new_value       String   @map("new_value")
  changed_by      String?  @map("changed_by") // Admin email/name
  change_note     String?  @map("change_note")
  created_at      DateTime @default(now()) @map("created_at")

  @@index([platform])
  @@index([created_at])
  @@map("app_version_history")
}

// Sales Activities with mandatory image proof
model SalesActivity {
  id                  Int                @id @default(autoincrement())
  sales_agent_id      Int                @map("sales_agent_id")
  survey_id           Int?               @map("survey_id")               // Optional: link to specific store/survey
  activity_type       SalesActivityType  @map("activity_type")
  activity_date       DateTime           @default(now()) @map("activity_date")

  // Mandatory proof
  proof_image_url     String             @map("proof_image_url")         // Required: screenshot/photo as proof

  // Optional additional details
  notes               String?                                            // Activity description/notes
  gps_latitude        Float?             @map("gps_latitude")            // Location when activity was logged
  gps_longitude       Float?             @map("gps_longitude")

  // Client/Store information (for non-survey activities)
  client_name         String?            @map("client_name")
  client_contact      String?            @map("client_contact")

  // Outcome tracking
  outcome             String?                                            // Result of the activity
  follow_up_required  Boolean            @default(false) @map("follow_up_required")
  follow_up_date      DateTime?          @map("follow_up_date")

  // Metadata
  created_at          DateTime           @default(now()) @map("created_at")
  updated_at          DateTime           @updatedAt @map("updated_at")

  // Relations
  sales_agent         User               @relation(fields: [sales_agent_id], references: [id], onDelete: Cascade)

  @@index([sales_agent_id])
  @@index([survey_id])
  @@index([activity_type])
  @@index([activity_date])
  @@index([follow_up_date])
  @@map("sales_activities")
}

// Orders from sales agents recording purchases
model Order {
  id                  Int       @id @default(autoincrement())
  order_number        String    @unique @map("order_number")
  survey_id           Int       @map("survey_id")
  sales_agent_id      Int       @map("sales_agent_id")

  // Store details
  store_name          String    @map("store_name")
  contact_person      String?   @map("contact_person")
  contact_number      String?   @map("contact_number")
  delivery_address    String    @map("delivery_address")

  // Products (free text, comma-separated)
  products            String                                  // e.g., "Product A, Product B, Product C"

  // Payment details
  total_amount        Decimal   @map("total_amount") @db.Decimal(12, 2)
  payment_terms       String    @map("payment_terms")         // COD, CASH, CREDIT
  amount_paid         Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance             Decimal   @map("balance") @db.Decimal(12, 2)

  // Status tracking
  status              String    @default("PENDING")           // PENDING, APPROVED, ASSIGNED_DELIVERY, DELIVERED, COLLECTED, COMPLETED

  // Admin approval
  approved_by         Int?      @map("approved_by")
  approved_at         DateTime? @map("approved_at")
  admin_notes         String?   @map("admin_notes")

  // Delivery assignment
  delivery_assigned_to    Int?      @map("delivery_assigned_to")
  delivery_assigned_at    DateTime? @map("delivery_assigned_at")
  delivery_completed_at   DateTime? @map("delivery_completed_at")
  delivery_proof_url      String?   @map("delivery_proof_url")

  // Collection assignment
  collector_assigned_to   Int?      @map("collector_assigned_to")
  collector_assigned_at   DateTime? @map("collector_assigned_at")
  collection_completed_at DateTime? @map("collection_completed_at")

  // Location
  gps_latitude        Float?    @map("gps_latitude")
  gps_longitude       Float?    @map("gps_longitude")

  // Proof of purchase
  proof_image_url     String    @map("proof_image_url")

  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  // Relations
  survey              Survey    @relation(fields: [survey_id], references: [id])
  sales_agent         User      @relation("OrderSalesAgent", fields: [sales_agent_id], references: [id])
  approver            User?     @relation("OrderApprover", fields: [approved_by], references: [id])
  delivery_user       User?     @relation("OrderDeliveryUser", fields: [delivery_assigned_to], references: [id])
  collector_user      User?     @relation("OrderCollectorUser", fields: [collector_assigned_to], references: [id])
  collections         Collection[]

  @@index([survey_id])
  @@index([sales_agent_id])
  @@index([status])
  @@index([approved_by])
  @@index([delivery_assigned_to])
  @@index([collector_assigned_to])
  @@index([created_at])
  @@map("orders")
}

// Collections tracking for payment collection
model Collection {
  id                  Int       @id @default(autoincrement())
  order_id            Int       @map("order_id")
  collector_id        Int       @map("collector_id")

  // Collection details
  amount_collected    Decimal   @map("amount_collected") @db.Decimal(12, 2)
  collection_date     DateTime  @default(now()) @map("collection_date")
  payment_method      String    @map("payment_method")    // CASH, CHECK, BANK_TRANSFER

  // Proof
  receipt_image_url   String    @map("receipt_image_url")

  // Location
  gps_latitude        Float?    @map("gps_latitude")
  gps_longitude       Float?    @map("gps_longitude")

  // Notes
  notes               String?

  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  // Relations
  order               Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  collector           User      @relation("CollectionCollector", fields: [collector_id], references: [id])

  @@index([order_id])
  @@index([collector_id])
  @@index([collection_date])
  @@map("collections")
}
